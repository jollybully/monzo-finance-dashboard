# Database (overridden in docker-compose for the app service)
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance

# Google Sheets (Monzo live export — read only)
GOOGLE_CREDENTIALS_FILE=/credentials/service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Monzo Transactions!A:O

# App
APP_TZ=Europe/London
RESERVED_BUFFER_DEFAULT=0

# SMTP / email reports
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_TO=
SMTP_USE_TLS=true

# Report schedules (Europe/London by default via APP_TZ)
REPORT_DAILY_ENABLED=true
REPORT_WEEKLY_ENABLED=true
REPORT_MONTHLY_ENABLED=true
REPORT_DAILY_HOUR=7
REPORT_DAILY_MINUTE=0
REPORT_WEEKLY_HOUR=7
REPORT_WEEKLY_MINUTE=30
REPORT_MONTHLY_HOUR=8
REPORT_MONTHLY_MINUTE=0

# Sync interval (minutes)
SYNC_INTERVAL_MINUTES=15
