# Database (overridden in docker-compose for the app service)
DATABASE_URL=your-database_url

# Google Sheets (Monzo live export — read only)
GOOGLE_CREDENTIALS_FILE=your-google_credentials_file
GOOGLE_SHEET_ID=your-google_sheet_id
GOOGLE_SHEET_RANGE=your-google_sheet_range

# App
APP_TZ=your-app_tz
RESERVED_BUFFER_DEFAULT=your-reserved_buffer_default

# SMTP / email reports
SMTP_HOST=your-smtp_host
SMTP_PORT=your-smtp_port
SMTP_USER=your-smtp_user
SMTP_PASSWORD=your-smtp_password
SMTP_FROM=your-smtp_from
SMTP_FROM_NAME=your-smtp_from_name
EMAIL_TO=your-email_to
SMTP_USE_TLS=your-smtp_use_tls

# Pushover (daily push + weekly/monthly teasers)
PUSHOVER_ENABLED=your-pushover_enabled
PUSHOVER_APP_TOKEN=your-pushover_app_token
PUSHOVER_USER_KEY=your-pushover_user_key
PUSHOVER_DEVICE=your-pushover_device

# Report schedules (Europe/London by default via APP_TZ)
REPORT_DAILY_ENABLED=your-report_daily_enabled
REPORT_WEEKLY_ENABLED=your-report_weekly_enabled
REPORT_MONTHLY_ENABLED=your-report_monthly_enabled
REPORT_DAILY_EMAIL=your-report_daily_email
REPORT_DAILY_HOUR=your-report_daily_hour
REPORT_DAILY_MINUTE=your-report_daily_minute
REPORT_WEEKLY_HOUR=your-report_weekly_hour
REPORT_WEEKLY_MINUTE=your-report_weekly_minute
REPORT_MONTHLY_HOUR=your-report_monthly_hour
REPORT_MONTHLY_MINUTE=your-report_monthly_minute

# Sync interval (minutes)
SYNC_INTERVAL_MINUTES=your-sync_interval_minutes


# Gemini coaching (Overview + weekly digest). Leave key blank to hide insights.
GEMINI_API_KEY=your-gemini_api_key
GEMINI_MODEL=your-gemini_model
INSIGHTS_ENABLED=your-insights_enabled